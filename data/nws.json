nds...\nAlto Pit OHV.","instruction":"Seek shelter inside a well-built structure and stay away from\nwindows. This storm is capable of producing damaging winds and large\nhail.","response":"Shelter","note":null,"parameters":{"AWIPSidentifier":["SVSFGZ"],"WMOidentifier":["WWUS55 KFGZ 211112"],"NWSheadline":["SEVERE THUNDERSTORM WARNING REMAINS IN EFFECT UNTIL 430 AM MST FOR YAVAPAI COUNTY"],"eventMotionDescription":["2026-10-21T10:59:00-00:00...storm...210DEG...36KT...34.63,-112.6"],"windThreat":["RADAR INDICATED"],"maxWindGust":["60 MPH"],"hailThreat":["RADAR INDICATED"],"maxHailSize":["1.50"],"BLOCKCHANNEL":["EAS","NWEM","CMAS"],"EAS-ORG":["WXR"],"VTEC":["/O.CON.KFGZ.SV.W.0144.000000T0000Z-261021T1130Z/"],"eventEndingTime":["2026-10-21T04:30:00-07:00"]},"scope":"Public","code":"IPAWSv1.0","language":"en-US","web":"http://www.weather.gov","eventCode":{"SAME":["SVS"],"NationalWeatherService":["SVW"]}}}]}