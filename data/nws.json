2.1","identifier":"urn:oid:2.49.0.1.840.0.1f12e54866dbe297df5336b1953067bd10aeed14.002.1","sender":"w-nws.webmaster@noaa.gov","sent":"2026-08-29T10:11:00-05:00"}],"sent":"2026-08-29T17:29:00-05:00","effective":"2026-08-29T17:29:00-05:00","onset":"2026-08-29T17:29:00-05:00","expires":"2026-08-30T10:00:00-05:00","ends":"2026-08-30T10:00:00-05:00","status":"Actual","messageType":"Update","category":"Met","severity":"Severe","certainty":"Observed","urgency":"Immediate","event":"Flood Warning","sender":"w-nws.webmaster@noaa.gov","senderName":"NWS Indianapolis IN","headline":"Flood Warning issued August 29 at 5:29PM CDT until August 30 at 10:00AM CDT by NWS Indianapolis IN","description":"...The Flood Warning continues for the following river in Illinois...\nIndiana...\n\nWabash River at Hutsonville to Vincennes\n\n.Minor flooding continues on the Wabash River from Hutsonville down\nto Vincennes. The river has crested. Flooding should come to an end\non the Wabash over the weekend.\n\n* WHAT...Minor flooding is forecast.\n\n* WHERE...Wabash River at Hutsonville Legacy Power Plant Site.\n\n* WHEN...Until Sunday morning.\n\n* IMPACTS...At 16.0 feet, Old Darwin Road and a few low rural roads\nbetween York and Hutsonville, Illinois begin to flood.\nAgricultural flooding begins along portions of the river.\n\n* ADDITIONAL DETAILS...\n- There is no current observed data.\n- Forecast...The river is expected to fall below flood stage late\nthis evening and continue falling to 6.6 feet Tuesday, September\n08.\n- Flood stage is 16.0 feet.\n- http://www.weather.gov/safety/flood","instruction":"Motorists should not attempt to drive around barricades or drive cars\nthrough flooded areas.\n\nCaution is urged when walking near riverbanks.\n\nAdditional information is available at www.weather.gov/ind.\n\nThe next statement will be issued Sunday morning at 915 AM CDT /1015\nAM EDT/.","response":"Avoid","note":null,"parameters":{"AWIPSidentifier":["FLSIND"],"WMOidentifier":["WGUS83 KIND 292229"],"NWSheadline":["FLOOD WARNING REMAINS IN EFFECT UNTIL SUNDAY MORNING"],"BLOCKCHANNEL":["EAS","NWEM","CMAS"],"EAS-ORG":["WXR"],"VTEC":["/O.CON.KIND.FL.W.0160.000000T0000Z-260830T1500Z/"],"eventEndingTime":["2026-08-30T10:00:00-05:00"],"expiredReferences":["w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.55513f7e9c408f5bc1ea8c3d4b8ca021151f81f3.003.1,2026-08-28T20:36:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.7d6d2ad6897bfc2053b7ba54c44a8a9b438cb92a.003.1,2026-08-28T09:43:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.cd9499db912cf41eedf6e7ed89ab331259907008.003.1,2026-08-27T20:38:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.6315cb2dc8d0f54eaa778ad01fb00cd0c181d340.004.1,2026-08-27T10:04:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.370c270d7d1b162addcf02dc7258854c454ad061.005.1,2026-08-26T13:04:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.12919d77a71ad3fa4d2d46fe4c889e8395a827c1.007.1,2026-08-26T09:14:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.21fed40f8a4270468743863bc5d2282950a3b72d.008.1,2026-08-25T13:12:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.966efdc66b3086f5aa2b21cb1cfbfa88e06cea31.009.1,2026-08-25T08:35:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.485716edaea873f78d95b8660a4bf26eec3149e1.010.1,2026-08-24T12:54:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.d17042b1f0925f697c4f2f6f4a97ea6a0fc7af62.008.1,2026-08-24T20:54:00-05:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.e611d888f0b860bf842f3076e8bd792348b6b8d0.010.1,2026-08-24T08:54:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.946a70c1dd6536458e250ec5f6d5adee0ba9c93c.003.1,2026-08-23T21:48:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.80aefc3a77c6080a84755a24ef28fd6d4a72367f.009.1,2026-08-23T11:49:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.edbe2de7e5035b03958c751aa8bc87fa20d1bfc9.003.1,2026-08-22T21:03:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.8