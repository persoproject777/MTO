35.97],[-111.66,36],[-111.64,36.07],[-111.67,36.13],[-111.7,36.15],[-111.69,36.18],[-111.78,36.2],[-111.81,36.2],[-111.81,36.17],[-111.76,36.17],[-111.72,36.15],[-111.69,36.06],[-111.7,35.98],[-111.69,35.95],[-111.59,35.92],[-111.59,35.93]]]},"properties":{"@id":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.eb78c70d614c522ed611c2267e3a6464a123fbf1.001.1","@type":"wx:Alert","id":"urn:oid:2.49.0.1.840.0.eb78c70d614c522ed611c2267e3a6464a123fbf1.001.1","areaDesc":"Coconino, AZ","geocode":{"SAME":["004005"],"UGC":["AZC005"]},"affectedZones":["https://api.weather.gov/zones/county/AZC005"],"references":[],"sent":"2026-08-29T17:22:00-07:00","effective":"2026-08-29T17:22:00-07:00","onset":"2026-08-29T17:22:00-07:00","expires":"2026-08-30T00:15:00-07:00","ends":"2026-08-30T00:15:00-07:00","status":"Actual","messageType":"Alert","category":"Met","severity":"Severe","certainty":"Likely","urgency":"Immediate","event":"Flash Flood Warning","sender":"w-nws.webmaster@noaa.gov","senderName":"NWS Flagstaff AZ","headline":"Flash Flood Warning issued August 29 at 5:22PM MST until August 30 at 12:15AM MST by NWS Flagstaff AZ","description":"FFWFGZ\n\nThe National Weather Service in Flagstaff has issued a\n\n* Flash Flood Warning for...\nCoconino County in north central Arizona...the Colorado River near\nmile marker 62.\n\n* Until 1215 AM MST /115 AM MDT/ Tonight.\n\n* At 522 PM MST /622 PM MDT/, Doppler radar indicated thunderstorms\nthat produced heavy rain earlier southwest of Cameron have resulted\nin a flash flood along the Little Colorado River west of Cameron.\nBetween 1 and 2 inches were estimate by radar earlier in the\nafternoon. Flash flooding is ongoing or expected to begin shortly.\nThe flood wave is expected to reach the Colorado River between 10\nPM and 1 AM.\n\nHAZARD...Life threatening flash flooding. Heavy rain from\nthunderstorms earlier.\n\nSOURCE...Radar indicated.\n\nIMPACT...Life threatening flash flooding along the Little Colorado\nRiver west of Cameron.\n\n* Some locations that will experience flash flooding include...\nLittle Colorado River Navajo Tribal Park.\n\nThis includes the following highways...\nthe Colorado River near mile marker 62. State Route 64 between mile\nmarkers 281 and 284.\n\nThis includes the following recreation areas and campgrounds...\nBlue Water Base Camp, Old Fish Camp Site, Above LCR Camp Site and\nBelow LCR Camp Site.\n\nThis includes the following swimming holes...\nBlue Water Base Camp.\n\nThis includes the following Little Colorado River west of Cameron.","instruction":"Flooding of washes and creeks will occur, some dirt roads will become\nmuddy and impassable. Paved roads and underpasses could become\nflooded as well.","response":"Avoid","note":null,"parameters":{"AWIPSidentifier":["FFWFGZ"],"WMOidentifier":["WGUS55 KFGZ 300022"],"flashFloodDetection":["RADAR INDICATED"],"flashFloodDamageThreat":["CONSIDERABLE"],"BLOCKCHANNEL":["EAS","NWEM"],"EAS-ORG":["WXR"],"VTEC":["/O.NEW.KFGZ.FF.W.0137.260830T0022Z-260830T0715Z/"],"eventEndingTime":["2026-08-30T00:15:00-07:00"],"WEAHandling":["Imminent Threat"],"CMAMtext":["NWS: FLASH FLOOD WARNING this area til 12:15 AM MST. Avoid flooded areas."],"CMAMlongtext":["National Weather Service: A FLASH FLOOD WARNING is in effect for this area until 12:15 AM MST. This is a dangerous and life-threatening situation. Do not attempt to travel unless you are fleeing an area subject to flooding or under an evacuation order."]},"scope":"Public","code":"IPAWSv1.0","language":"en-US","web":"http://www.weather.gov","eventCode":{"SAME":["FFW"],"NationalWeatherService":["FFW"]}}}]}